{
  "name": "agentlytics-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  // Hourly: rollups, spike detection and retention.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentlytics-mcp",
      // Paste the id printed by: npx wrangler d1 create agentlytics-mcp (the Deploy to Cloudflare button fills it in for you)
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
  // Settings (npx wrangler secret put NAME, or asked for by the Deploy to Cloudflare button): SITE_DOMAIN, HASH_SECRET, MCP_READ_KEY.
  // Optional per-IP cap on /collect: add
  //   "ratelimits": [{ "name": "COLLECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }]
}
